{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CmsTemplate;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "MultiTenancy": {
    "Enabled": false,
    "ResolutionStrategy": "Host",
    "HeaderName": "X-Tenant"
  },
  "Authentication": {
    "Google": { "ClientId": "", "ClientSecret": "" },
    "Microsoft": { "ClientId": "", "ClientSecret": "" }
  },
  "Jwt": {
    "Issuer": "cms-template",
    "Audience": "cms-template",
    "SigningKey": "dev-only-signing-key-change-me-in-production-0123456789abcdef",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Email": {
    "Smtp": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 587,
      "EnableSsl": true,
      "User": "",
      "Password": "",
      "FromAddress": "no-reply@cms.local",
      "FromName": "CMS Template"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
