@model PagedResult<ContentListItemDto>
@using CMS.Domain.Enums
@{
    var type = (ContentType)ViewBag.Type;
    ViewData["Title"] = ViewBag.Title as string;
    string? search = ViewBag.Search;
    var status = ViewBag.Status as ContentStatus?;
    var listAction = type == ContentType.Post ? "Posts" : "Pages";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Create" asp-route-type="@type" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New @(type == ContentType.Post ? "post" : "page")</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="@listAction" class="row g-2 align-items-end mb-3">
            <div class="col-md-6">
                <input type="search" name="search" value="@search" class="form-control form-control-sm" placeholder="Search title or slug" />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">Any status</option>
                    @foreach (var s in Enum.GetValues<ContentStatus>())
                    {
                        <option value="@s" selected="@(status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr class="text-secondary small"><th>Title</th><th>Status</th><th>Category</th><th>Modified</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-medium">@item.Title @(item.IsHomePage ? "🏠" : "")</div>
                            <div class="text-secondary small">/@item.Slug</div>
                        </td>
                        <td>
                            @{
                                var css = item.Status switch
                                {
                                    ContentStatus.Published => "success",
                                    ContentStatus.Scheduled => "info",
                                    ContentStatus.Archived => "secondary",
                                    _ => "warning",
                                };
                            }
                            <span class="badge text-bg-@css">@item.Status</span>
                        </td>
                        <td class="small">@item.Category</td>
                        <td class="small text-secondary">@item.ModifiedOnUtc?.LocalDateTime.ToString("g")</td>
                        <td class="text-end">
                            <a asp-action="Preview" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Preview</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" asp-route-type="@type" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" data-cms-confirm="Delete '@item.Title'?">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">Nothing here yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="@(new PagerModel(Model.PageNumber, Model.TotalPages, Model.TotalCount, Model.FirstItemIndex, Model.LastItemIndex))" />
    </div>
</div>
