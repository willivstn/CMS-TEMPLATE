@model ContentFormViewModel
@using CMS.Domain.Enums
@{
    var noun = Model.Type == ContentType.Post ? "post" : "page";
    ViewData["Title"] = "Edit " + noun;
    var listAction = Model.Type == ContentType.Post ? "Posts" : "Pages";
    var statusCss = Model.Status switch
    {
        ContentStatus.Published => "success",
        ContentStatus.Scheduled => "info",
        ContentStatus.Archived => "secondary",
        _ => "warning",
    };
}

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <h1 class="h3 mb-0">Edit @noun</h1>
        <span class="badge text-bg-@statusCss">@Model.Status</span>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="@listAction" class="btn btn-sm btn-outline-secondary">List</a>
        <a asp-action="Preview" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary" target="_blank"><i class="bi bi-eye me-1"></i>Preview</a>
        <a asp-action="Revisions" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clock-history me-1"></i>Revisions</a>

        @if (Model.Status != ContentStatus.Published)
        {
            <form asp-action="Publish" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-success"><i class="bi bi-send me-1"></i>Publish</button></form>
        }
        else
        {
            <form asp-action="Unpublish" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-outline-warning">Unpublish</button></form>
        }
        @if (Model.Status != ContentStatus.Archived)
        {
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-outline-secondary" data-cms-confirm="Archive this @noun?">Archive</button></form>
        }
    </div>
</div>

<form asp-action="Edit" method="post">
    <partial name="_ContentFormFields" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ContentFormScripts" />
}
