@model ContentFormViewModel
@using CMS.Domain.Enums
@{
    var noun = Model.Type == ContentType.Post ? "post" : "page";
    ViewData["Title"] = "New " + noun;
    var listAction = Model.Type == ContentType.Post ? "Posts" : "Pages";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">New @noun</h1>
    <a asp-action="@listAction" class="btn btn-sm btn-outline-secondary">Cancel</a>
</div>

<form asp-action="Create" method="post">
    <partial name="_ContentFormFields" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create @noun</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ContentFormScripts" />
}
