@model IReadOnlyList<CMS.Application.Features.Tags.TagListItemDto>
@{ ViewData["Title"] = "Tags"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Tags</h1>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0">Add tag</h2></div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="d-flex gap-2">
                    <input type="text" name="name" class="form-control form-control-sm" placeholder="Tag name" required />
                    <button type="submit" class="btn btn-primary btn-sm">Add</button>
                </form>
                <p class="text-secondary small mt-2 mb-0">Tags are also created automatically when you tag content.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr class="text-secondary small"><th>Name</th><th>Uses</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td><div class="fw-medium">@t.Name</div><div class="text-secondary small">/@t.Slug</div></td>
                            <td>@t.UsageCount</td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger" data-cms-confirm="Delete tag '@t.Name'?">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-secondary py-4">No tags yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
