@model PagedResult<UserListItemDto>
@{
    ViewData["Title"] = "Users";
    var roles = ViewBag.Roles as IReadOnlyList<RoleOptionDto> ?? [];
    string? search = ViewBag.Search;
    string? roleFilter = ViewBag.Role;
    bool? active = ViewBag.Active;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Users</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New user</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-md-5">
                <label class="form-label small text-secondary">Search</label>
                <input type="search" name="search" value="@search" class="form-control form-control-sm" placeholder="Name or email" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-secondary">Role</label>
                <select name="role" class="form-select form-select-sm">
                    <option value="">All roles</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r.Name" selected="@(r.Name == roleFilter)">@r.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary">Status</label>
                <select name="active" class="form-select form-select-sm">
                    <option value="">Any</option>
                    <option value="true" selected="@(active == true)">Active</option>
                    <option value="false" selected="@(active == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr class="text-secondary small">
                        <th>User</th><th>Roles</th><th>Status</th><th>Last login</th><th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var user in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-medium">@user.DisplayName</div>
                            <div class="text-secondary small">@user.Email</div>
                        </td>
                        <td>
                            @foreach (var r in user.Roles)
                            {
                                <span class="badge text-bg-light border me-1">@r</span>
                            }
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge text-bg-danger">Locked</span>
                            }
                            else if (user.IsActive)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                            @if (!user.EmailConfirmed)
                            {
                                <span class="badge text-bg-warning">Unconfirmed</span>
                            }
                        </td>
                        <td class="small text-secondary">@(user.LastLoginUtc?.LocalDateTime.ToString("g") ?? "Never")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Manage</a>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No users found.</td></tr>
                }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="@(new PagerModel(Model.PageNumber, Model.TotalPages, Model.TotalCount, Model.FirstItemIndex, Model.LastItemIndex))" />
    </div>
</div>
