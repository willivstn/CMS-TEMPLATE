@model UserPermissionsViewModel
@{ ViewData["Title"] = "Permission overrides"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-0">Permission overrides</h1>
        <span class="text-secondary">@Model.DisplayName</span>
    </div>
    <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-sm btn-outline-secondary">Back</a>
</div>

<div class="alert alert-info d-flex align-items-center">
    <i class="bi bi-info-circle me-2"></i>
    <div><strong>Inherit</strong> uses the user's roles. <strong>Grant</strong> adds a permission; <strong>Deny</strong> removes one a role would otherwise give (deny wins).</div>
</div>

<form asp-action="Permissions" asp-route-id="@Model.UserId" method="post">
    <div class="row g-3">
        @foreach (var group in Model.Groups)
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0">@group.Group</h2></div>
                    <div class="card-body pt-2">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                            @foreach (var p in group.Items)
                            {
                                var state = Model.Grants.Contains(p.Name) ? "grant" : Model.Denies.Contains(p.Name) ? "deny" : "inherit";
                                <tr>
                                    <td>
                                        <div class="small fw-medium">@p.DisplayName</div>
                                        <div class="text-secondary" style="font-size:.72rem">@p.Name</div>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <input type="radio" class="btn-check" name="states[@p.Name]" id="i_@p.Name" value="inherit" checked="@(state == "inherit")" autocomplete="off">
                                            <label class="btn btn-outline-secondary" for="i_@p.Name">Inherit</label>
                                            <input type="radio" class="btn-check" name="states[@p.Name]" id="g_@p.Name" value="grant" checked="@(state == "grant")" autocomplete="off">
                                            <label class="btn btn-outline-success" for="g_@p.Name">Grant</label>
                                            <input type="radio" class="btn-check" name="states[@p.Name]" id="d_@p.Name" value="deny" checked="@(state == "deny")" autocomplete="off">
                                            <label class="btn btn-outline-danger" for="d_@p.Name">Deny</label>
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save overrides</button>
    </div>
</form>
