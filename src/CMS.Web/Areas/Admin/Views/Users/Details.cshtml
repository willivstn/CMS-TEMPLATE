@model UserDetailsDto
@{ ViewData["Title"] = Model.DisplayName; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.DisplayName</h1>
        <span class="text-secondary">@Model.Email</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to list</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0">Profile</h2></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-secondary fw-normal">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsLockedOut)
                        {
                            <span class="badge text-bg-danger">Locked until @Model.LockoutEndUtc?.LocalDateTime.ToString("g")</span>
                        }
                        else if (Model.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </dd>
                    <dt class="col-sm-4 text-secondary fw-normal">Email confirmed</dt>
                    <dd class="col-sm-8">@(Model.EmailConfirmed ? "Yes" : "No")</dd>
                    <dt class="col-sm-4 text-secondary fw-normal">Two-factor</dt>
                    <dd class="col-sm-8">@(Model.TwoFactorEnabled ? "Enabled" : "Disabled")</dd>
                    <dt class="col-sm-4 text-secondary fw-normal">Failed logins</dt>
                    <dd class="col-sm-8">@Model.AccessFailedCount</dd>
                    <dt class="col-sm-4 text-secondary fw-normal">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedOnUtc.LocalDateTime.ToString("g")</dd>
                    <dt class="col-sm-4 text-secondary fw-normal">Last login</dt>
                    <dd class="col-sm-8">@(Model.LastLoginUtc?.LocalDateTime.ToString("g") ?? "Never")</dd>
                    <dt class="col-sm-4 text-secondary fw-normal">Roles</dt>
                    <dd class="col-sm-8">
                        @foreach (var r in Model.Roles)
                        {
                            <span class="badge text-bg-light border me-1">@r</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0">Recent sign-ins</h2></div>
            <div class="card-body pt-2">
                @if (Model.RecentLogins.Count == 0)
                {
                    <p class="text-secondary small mb-0">No sign-in history.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tbody>
                        @foreach (var login in Model.RecentLogins)
                        {
                            <tr>
                                <td>
                                    @if (login.Succeeded)
                                    {
                                        <span class="badge text-bg-success">OK</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">@login.FailureReason</span>
                                    }
                                </td>
                                <td class="small text-secondary">@login.IpAddress</td>
                                <td class="small text-secondary text-end">@login.TimestampUtc.LocalDateTime.ToString("g")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0">Actions</h2></div>
            <div class="card-body d-grid gap-2">
                <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm text-start">
                    <i class="bi bi-key me-2"></i>Reset password
                </a>
                <a asp-action="Permissions" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm text-start">
                    <i class="bi bi-shield-check me-2"></i>Permission overrides
                </a>
                @if (Model.IsLockedOut)
                {
                    <form asp-action="Unlock" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-success btn-sm w-100 text-start"><i class="bi bi-unlock me-2"></i>Unlock account</button>
                    </form>
                }
                else
                {
                    <form asp-action="Lock" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-warning btn-sm w-100 text-start"
                                data-cms-confirm="Lock this account out?"><i class="bi bi-lock me-2"></i>Lock account</button>
                    </form>
                }
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 text-start"
                            data-cms-confirm="Delete this user? This can be undone by an administrator.">
                        <i class="bi bi-trash me-2"></i>Delete user
                    </button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0">Effective permissions (@Model.Permissions.Count)</h2></div>
            <div class="card-body pt-2">
                <div class="d-flex flex-wrap gap-1" style="max-height: 240px; overflow-y: auto;">
                    @foreach (var p in Model.Permissions)
                    {
                        <span class="badge text-bg-light border">@p</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
