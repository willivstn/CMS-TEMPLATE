@model IReadOnlyList<FeatureFlagDto>
@{ ViewData["Title"] = "Feature Flags"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Feature Flags</h1>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0">New flag</h2></div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-2"><input name="name" class="form-control form-control-sm" placeholder="Feature.Name" required /></div>
                    <div class="mb-2"><input name="description" class="form-control form-control-sm" placeholder="Description" /></div>
                    <div class="mb-2"><input name="environment" class="form-control form-control-sm" placeholder="Environment (optional)" /></div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="isEnabled" value="true" id="newEnabled" />
                        <label class="form-check-label small" for="newEnabled">Enabled</label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Create flag</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr class="text-secondary small"><th>Flag</th><th>Environment</th><th>Enabled</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td><div class="fw-medium">@f.Name</div><div class="text-secondary small">@f.Description</div></td>
                            <td class="small">@(f.Environment ?? "all")</td>
                            <td>
                                <form asp-action="Toggle" asp-route-id="@f.Id" method="post" class="d-inline">
                                    <input type="hidden" name="isEnabled" value="@((!f.IsEnabled).ToString().ToLowerInvariant())" />
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" role="switch" checked="@f.IsEnabled" onchange="this.closest('form').submit()" />
                                    </div>
                                </form>
                            </td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@f.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger" data-cms-confirm="Delete flag '@f.Name'?">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-secondary py-4">No feature flags yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
