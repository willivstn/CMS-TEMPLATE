@model CategoryFormViewModel
@{ ViewData["Title"] = "Edit category"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Edit category</h1>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to list</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body" style="max-width: 640px;">
        <form asp-action="Edit" method="post">
            <partial name="_CategoryFormFields" model="Model" />
            <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
