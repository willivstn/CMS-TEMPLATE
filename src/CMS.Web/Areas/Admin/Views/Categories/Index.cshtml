@model IReadOnlyList<CMS.Application.Features.Categories.CategoryListItemDto>
@{ ViewData["Title"] = "Categories"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Categories</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New category</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr class="text-secondary small"><th>Name</th><th>Parent</th><th>Content</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>
                        <div class="fw-medium">@c.Name</div>
                        <div class="text-secondary small">/@c.Slug</div>
                    </td>
                    <td class="small">@c.ParentName</td>
                    <td>@c.ContentCount</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" data-cms-confirm="Delete '@c.Name'?">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-secondary py-4">No categories yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
