@model CategoryFormViewModel

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Slug" class="form-label"></label>
    <input asp-for="Slug" class="form-control" placeholder="auto-generated from name" />
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
</div>
<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="ParentId" class="form-label"></label>
        <select asp-for="ParentId" class="form-select">
            <option value="">— none —</option>
            @foreach (var p in Model.Parents)
            {
                <option value="@p.Id" selected="@(Model.ParentId == p.Id)">@p.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="SortOrder" class="form-label"></label>
        <input asp-for="SortOrder" class="form-control" type="number" />
    </div>
</div>
