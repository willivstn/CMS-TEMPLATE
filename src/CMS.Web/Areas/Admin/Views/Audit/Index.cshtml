@model PagedResult<AuditLogDto>
@{
    ViewData["Title"] = "Audit Trail";
    string? entity = ViewBag.Entity;
    string? search = ViewBag.Search;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Audit Trail</h1>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-md-4"><input type="search" name="search" value="@search" class="form-control form-control-sm" placeholder="User or entity id" /></div>
            <div class="col-md-4"><input type="text" name="entity" value="@entity" class="form-control form-control-sm" placeholder="Entity name (e.g. ContentItem)" /></div>
            <div class="col-md-2 d-grid"><button type="submit" class="btn btn-outline-secondary btn-sm">Filter</button></div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr class="text-secondary small"><th>Action</th><th>Entity</th><th>User</th><th>IP</th><th class="text-end">When</th></tr></thead>
                <tbody>
                @foreach (var log in Model.Items)
                {
                    <tr>
                        <td><span class="badge text-bg-light border">@log.Action</span></td>
                        <td class="small">@log.EntityName <span class="text-secondary">@log.EntityId</span></td>
                        <td class="small">@log.UserName</td>
                        <td class="small text-secondary">@log.IpAddress</td>
                        <td class="text-end small text-secondary">@log.TimestampUtc.LocalDateTime.ToString("g")</td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No audit entries.</td></tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="@(new PagerModel(Model.PageNumber, Model.TotalPages, Model.TotalCount, Model.FirstItemIndex, Model.LastItemIndex))" />
    </div>
</div>
