@model EmailTemplateFormViewModel
@{ ViewData["Title"] = "Edit email template"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Edit email template</h1>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to list</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Key" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Key</label>
                    <input class="form-control" value="@Model.Key" disabled />
                </div>
                <div class="col-md-8">
                    <label asp-for="Subject" class="form-label"></label>
                    <input asp-for="Subject" class="form-control" />
                    <span asp-validation-for="Subject" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HtmlBody" class="form-label"></label>
                    <textarea asp-for="HtmlBody" class="form-control font-monospace" rows="10"></textarea>
                    <span asp-validation-for="HtmlBody" class="text-danger small"></span>
                    @if (!string.IsNullOrWhiteSpace(Model.AvailableTokens))
                    {
                        <div class="form-text">Tokens: @Model.AvailableTokens</div>
                    }
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Save template</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
