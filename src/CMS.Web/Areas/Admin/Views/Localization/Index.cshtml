@model IReadOnlyList<LanguageDto>
@{ ViewData["Title"] = "Localization"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Localization</h1>
    <a asp-action="Translations" class="btn btn-sm btn-outline-secondary"><i class="bi bi-translate me-1"></i>Translations</a>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0">Add language</h2></div>
            <div class="card-body">
                <form asp-action="CreateLanguage" method="post">
                    <div class="mb-2"><input name="Code" class="form-control form-control-sm" placeholder="Code (e.g. fr-FR)" required /></div>
                    <div class="mb-2"><input name="Name" class="form-control form-control-sm" placeholder="Name (e.g. French)" required /></div>
                    <div class="mb-2"><input name="NativeName" class="form-control form-control-sm" placeholder="Native name (e.g. Français)" /></div>
                    <div class="mb-2"><input name="SortOrder" type="number" value="0" class="form-control form-control-sm" /></div>
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="IsRtl" value="true" id="rtl" /><label class="form-check-label small" for="rtl">Right-to-left</label></div>
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="IsEnabled" value="true" id="en" checked /><label class="form-check-label small" for="en">Enabled</label></div>
                    <button type="submit" class="btn btn-primary btn-sm">Add</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr class="text-secondary small"><th>Language</th><th>Code</th><th>Flags</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td><div class="fw-medium">@l.Name</div><div class="text-secondary small">@l.NativeName</div></td>
                            <td><code class="small">@l.Code</code></td>
                            <td>
                                @if (l.IsDefault) { <span class="badge text-bg-primary">default</span> }
                                @if (l.IsRtl) { <span class="badge text-bg-light border">RTL</span> }
                                @if (!l.IsEnabled) { <span class="badge text-bg-secondary">disabled</span> }
                            </td>
                            <td class="text-end">
                                <a asp-action="EditLanguage" asp-route-id="@l.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                @if (!l.IsDefault)
                                {
                                    <form asp-action="SetDefaultLanguage" asp-route-id="@l.Id" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-outline-primary">Set default</button>
                                    </form>
                                    <form asp-action="DeleteLanguage" asp-route-id="@l.Id" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-outline-danger" data-cms-confirm="Delete '@l.Name'?">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
