@model MediaLibraryViewModel
@using CMS.Domain.Enums
@{
    ViewData["Title"] = "Media Library";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Media Library</h1>
    @if (Model.CurrentFolderId is not null)
    {
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-up-left me-1"></i>All files</a>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0"><i class="bi bi-upload me-2"></i>Upload</h2></div>
            <div class="card-body">
                <form asp-action="Upload" asp-route-folderId="@Model.CurrentFolderId" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                    <input type="file" name="files" class="form-control form-control-sm" multiple required />
                    <button type="submit" class="btn btn-primary btn-sm">Upload</button>
                </form>
                <p class="text-secondary small mt-2 mb-0">Images get a thumbnail automatically. Max 50 MB per file.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3"><h2 class="h6 mb-0"><i class="bi bi-folder-plus me-2"></i>New folder</h2></div>
            <div class="card-body">
                <form asp-action="CreateFolder" method="post" class="d-flex gap-2">
                    <input type="hidden" name="parentId" value="@Model.CurrentFolderId" />
                    <input type="text" name="name" class="form-control form-control-sm" placeholder="Folder name" required />
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Create</button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.Folders.Count > 0)
{
    <div class="row g-2 mb-3">
        @foreach (var folder in Model.Folders)
        {
            <div class="col-6 col-md-3 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-2 d-flex align-items-center gap-2">
                        <a asp-action="Index" asp-route-folderId="@folder.Id" class="stretched-link text-decoration-none text-body d-flex align-items-center gap-2">
                            <i class="bi bi-folder-fill text-warning fs-4"></i>
                            <span class="small text-truncate">@folder.Name</span>
                        </a>
                        <form asp-action="DeleteFolder" asp-route-id="@folder.Id" asp-route-parentId="@Model.CurrentFolderId" method="post" class="ms-auto position-relative" style="z-index:2;">
                            <button class="btn btn-sm btn-link text-danger p-0" data-cms-confirm="Delete folder '@folder.Name'?"><i class="bi bi-x"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (Model.Items.Items.Count == 0)
        {
            <p class="text-secondary text-center py-4 mb-0">No files in this folder yet.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in Model.Items.Items)
                {
                    <div class="col-6 col-md-4 col-xl-3">
                        <div class="card h-100 border">
                            <div class="ratio ratio-4x3 bg-body-tertiary d-flex align-items-center justify-content-center">
                                @if (item.ThumbnailUrl is not null || item.Type == MediaType.Image)
                                {
                                    <img src="@(item.ThumbnailUrl ?? item.Url)" class="card-img-top" style="object-fit:cover;" alt="@item.AltText" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center"><i class="bi bi-file-earmark-text fs-1 text-secondary"></i></div>
                                }
                            </div>
                            <div class="card-body p-2">
                                <div class="small text-truncate" title="@item.OriginalFileName">@item.OriginalFileName</div>
                                <div class="text-secondary" style="font-size:.72rem">@(item.SizeBytes / 1024) KB @(item.Width is not null ? $"· {item.Width}×{item.Height}" : "")</div>
                            </div>
                            <div class="card-footer p-1 d-flex gap-1 bg-transparent border-0">
                                <a href="@item.Url" target="_blank" class="btn btn-sm btn-outline-secondary flex-fill">Open</a>
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill cms-edit-media"
                                        data-id="@item.Id" data-alt="@item.AltText" data-title="@item.Title"
                                        data-bs-toggle="modal" data-bs-target="#mediaMetaModal">Info</button>
                                <form asp-action="Delete" asp-route-id="@item.Id" asp-route-folderId="@Model.CurrentFolderId" method="post">
                                    <button class="btn btn-sm btn-outline-danger" data-cms-confirm="Delete this file?"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <partial name="_Pager" model="@(new PagerModel(Model.Items.PageNumber, Model.Items.TotalPages, Model.Items.TotalCount, Model.Items.FirstItemIndex, Model.Items.LastItemIndex))" />
        }
    </div>
</div>

<div class="modal fade" id="mediaMetaModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="EditMeta" asp-route-folderId="@Model.CurrentFolderId" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title">File info</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="metaId" />
                <div class="mb-3"><label class="form-label">Alt text</label><input name="AltText" id="metaAlt" class="form-control" /></div>
                <div class="mb-3"><label class="form-label">Title</label><input name="Title" id="metaTitle" class="form-control" /></div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.cms-edit-media').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('metaId').value = btn.dataset.id;
                document.getElementById('metaAlt').value = btn.dataset.alt || '';
                document.getElementById('metaTitle').value = btn.dataset.title || '';
            });
        });
    </script>
}
