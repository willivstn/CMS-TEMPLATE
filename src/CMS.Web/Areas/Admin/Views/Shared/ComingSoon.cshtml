@{
    var title = ViewData["Title"] as string ?? "Section";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">@title</h1>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
        <div class="display-5 mb-3"><i class="bi bi-cone-striped text-warning"></i></div>
        <h2 class="h5">@title is coming soon</h2>
        <p class="text-secondary mb-0">
            This section is scaffolded and reachable through the permission-filtered
            navigation. Its full implementation lands in a later phase.
        </p>
    </div>
</div>
