@model IReadOnlyList<AnnouncementListDto>
@{ ViewData["Title"] = "Announcements"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-0">Announcements</h1>
        <span class="text-secondary small">Sample module — demonstrates the extension pattern.</span>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New announcement</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead><tr class="text-secondary small"><th>Title</th><th>Status</th><th>Updated</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="fw-medium">@a.Title</td>
                    <td>@(a.IsPublished ? Html.Raw("<span class='badge text-bg-success'>Published</span>") : Html.Raw("<span class='badge text-bg-secondary'>Draft</span>"))</td>
                    <td class="small text-secondary">@a.ModifiedOnUtc?.LocalDateTime.ToString("g")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" data-cms-confirm="Delete '@a.Title'?">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-secondary py-4">No announcements yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
