@model PagedResult<JobRunDto>
@using CMS.Domain.Enums
@{ ViewData["Title"] = "Background Jobs"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Background Jobs</h1>
    <a href="/hangfire" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-up-right me-1"></i>Hangfire dashboard</a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2">
        <span class="text-secondary small align-self-center me-2">Run now:</span>
        @foreach (var (id, label) in new[] { ("content", "Publish scheduled content"), ("email", "Process email queue"), ("cleanup", "Cleanup old logs") })
        {
            <form asp-action="Run" method="post">
                <input type="hidden" name="job" value="@id" />
                <button type="submit" class="btn btn-sm btn-outline-primary">@label</button>
            </form>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-sm align-middle mb-0">
            <thead><tr class="text-secondary small"><th>Job</th><th>Status</th><th>Result</th><th class="text-end">Finished</th></tr></thead>
            <tbody>
            @foreach (var run in Model.Items)
            {
                var css = run.Status switch { JobStatus.Succeeded => "success", JobStatus.Failed => "danger", JobStatus.Processing => "info", _ => "secondary" };
                <tr>
                    <td class="small fw-medium">@run.JobName</td>
                    <td><span class="badge text-bg-@css">@run.Status</span></td>
                    <td class="small text-secondary">@(run.Error ?? run.Result)</td>
                    <td class="text-end small text-secondary">@run.FinishedOnUtc?.LocalDateTime.ToString("g")</td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-secondary py-4">No job runs yet.</td></tr>
            }
            </tbody>
        </table>
        <partial name="_Pager" model="@(new PagerModel(Model.PageNumber, Model.TotalPages, Model.TotalCount, Model.FirstItemIndex, Model.LastItemIndex))" />
    </div>
</div>
