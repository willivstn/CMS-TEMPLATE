@model RolePermissionsViewModel
@{ ViewData["Title"] = $"Permissions · {Model.RoleName}"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-0">Role permissions</h1>
        <span class="text-secondary">@Model.RoleName</span>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to roles</a>
</div>

@if (Model.RoleName == "Administrator")
{
    <div class="alert alert-info d-flex align-items-center">
        <i class="bi bi-info-circle me-2"></i>
        <div>Administrators implicitly hold every permission, including any added later — these checkboxes are informational.</div>
    </div>
}

<form asp-action="Permissions" asp-route-id="@Model.RoleId" method="post">
    <div class="row g-3">
        @foreach (var group in Model.Groups)
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-3 d-flex align-items-center justify-content-between">
                        <h2 class="h6 mb-0">@group.Group</h2>
                        <input type="checkbox" class="form-check-input cms-group-toggle" title="Toggle all" />
                    </div>
                    <div class="card-body pt-2">
                        @foreach (var p in group.Items)
                        {
                            <div class="form-check">
                                <input class="form-check-input cms-perm" type="checkbox" name="permissions" value="@p.Name"
                                       id="perm_@p.Name" checked="@(Model.Selected.Contains(p.Name))" />
                                <label class="form-check-label" for="perm_@p.Name">
                                    @p.DisplayName <span class="text-secondary small">(@p.Name)</span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save permissions</button>
    </div>
</form>

@section Scripts {
    <script>
        // "Toggle all" checkbox per group card.
        document.querySelectorAll('.cms-group-toggle').forEach(function (toggle) {
            const card = toggle.closest('.card');
            const boxes = card.querySelectorAll('.cms-perm');
            toggle.checked = Array.from(boxes).every(b => b.checked);
            toggle.addEventListener('change', () => boxes.forEach(b => { b.checked = toggle.checked; }));
        });
    </script>
}
