@{ ViewData["Title"] = "Check your email"; }

<div class="row justify-content-center">
  <div class="col-md-6 text-center mt-5">
    <div class="display-6 mb-3">📧</div>
    <h1 class="h4">Almost there</h1>
    <p class="text-muted">We've sent a confirmation link to your email address. Click it to activate your account.</p>
    <p class="small text-muted">In development, the link is written to the application log.</p>
    <a asp-action="Login" class="btn btn-outline-primary mt-2">Back to sign in</a>
  </div>
</div>
