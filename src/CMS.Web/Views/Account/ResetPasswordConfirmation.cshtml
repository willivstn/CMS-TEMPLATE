@{ ViewData["Title"] = "Password reset"; }

<div class="row justify-content-center">
  <div class="col-md-6 text-center mt-5">
    <div class="display-6 mb-3">✅</div>
    <h1 class="h4">Password reset</h1>
    <p class="text-muted">Your password has been changed. You can now sign in with your new password.</p>
    <a asp-action="Login" class="btn btn-primary mt-2">Sign in</a>
  </div>
</div>
