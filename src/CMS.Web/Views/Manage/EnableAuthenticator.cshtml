@model CMS.Web.Models.Account.EnableAuthenticatorViewModel
@{ ViewData["Title"] = "Set up authenticator"; }

<div class="row justify-content-center">
  <div class="col-md-7 mt-4">
    <h1 class="h4 mb-3">Set up authenticator app</h1>

    <div class="card shadow-sm">
      <div class="card-body">
        <ol class="small">
          <li>Install an authenticator app (Google Authenticator, Authy, 1Password…).</li>
          <li>Add a new account and enter this key manually, or open the setup link:</li>
        </ol>

        <div class="mb-2">
          <label class="form-label small text-secondary">Setup key</label>
          <input class="form-control font-monospace" value="@Model.SharedKey" readonly onclick="this.select()" />
        </div>
        <div class="mb-3">
          <a href="@Model.AuthenticatorUri" class="small">Open in authenticator app (otpauth link)</a>
        </div>

        <form asp-action="EnableAuthenticator" method="post">
          <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
          <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" placeholder="123456" />
            <span asp-validation-for="Code" class="text-danger small"></span>
          </div>
          <button type="submit" class="btn btn-primary">Verify &amp; enable</button>
          <a asp-action="Security" class="btn btn-link">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
