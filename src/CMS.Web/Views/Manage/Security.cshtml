@{
    ViewData["Title"] = "Account security";
    var enabled = ViewBag.TwoFactorEnabled is true;
}

<div class="row justify-content-center">
  <div class="col-md-7 mt-4">
    <partial name="_Flash" />
    <h1 class="h4 mb-3">Account security</h1>

    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="h6">Two-factor authentication (2FA)</h2>
        <p class="text-muted small mb-3">Protect your account with an authenticator app (Google Authenticator, Authy, 1Password, …).</p>

        @if (enabled)
        {
          <div class="alert alert-success d-flex align-items-center py-2"><i class="bi bi-shield-check me-2"></i>2FA is <strong class="mx-1">enabled</strong> on your account.</div>
          <form asp-action="Disable2fa" method="post">
            <button type="submit" class="btn btn-outline-danger btn-sm" data-cms-confirm="Disable two-factor authentication?">Disable 2FA</button>
          </form>
        }
        else
        {
          <div class="alert alert-warning d-flex align-items-center py-2"><i class="bi bi-shield-exclamation me-2"></i>2FA is <strong class="mx-1">not enabled</strong>.</div>
          <a asp-action="EnableAuthenticator" class="btn btn-primary btn-sm">Set up authenticator app</a>
        }
      </div>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-link btn-sm mt-2">Back to site</a>
  </div>
</div>

@section Scripts { <script src="~/js/admin.js"></script> }
