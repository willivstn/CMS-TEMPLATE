@using System.Security.Claims
@{ ViewData["Title"] = "Secure area"; }

<div class="mt-4">
  <h1 class="h4">🔒 Secure area</h1>
  <p class="text-muted">
    You reached this page because your account holds the
    <code>Dashboard.View</code> permission. Authorization was resolved from claims
    with no database round-trip.
  </p>

  <h2 class="h6 mt-4">Your permissions</h2>
  <div class="d-flex flex-wrap gap-1">
    @foreach (var claim in User.FindAll("permission").OrderBy(c => c.Value))
    {
      <span class="badge text-bg-secondary">@claim.Value</span>
    }
  </div>
</div>
