@model IReadOnlyList<CMS.Web.Navigation.MenuNodeViewModel>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">
                <i class="bi bi-house-door"></i>
            </a>
        </li>
        @for (var i = 0; i < Model.Count; i++)
        {
            var node = Model[i];
            var isLast = i == Model.Count - 1;
            <li class="breadcrumb-item @(isLast ? "active" : null)" aria-current="@(isLast ? "page" : null)">
                @if (!isLast && node.Url is not null)
                {
                    <a href="@node.Url" class="text-decoration-none">@node.Title</a>
                }
                else
                {
                    @node.Title
                }
            </li>
        }
    </ol>
</nav>
