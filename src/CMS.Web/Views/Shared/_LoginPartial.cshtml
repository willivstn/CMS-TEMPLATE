@using System.Security.Claims
<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    var name = User.FindFirstValue("display_name") ?? User.Identity!.Name;
    <li class="nav-item">
        <span class="nav-link text-dark">Hi, @name</span>
    </li>
    <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-link nav-link text-dark">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Sign in</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
    </li>
}
</ul>
