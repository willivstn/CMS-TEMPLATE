@model CMS.Web.Models.Components.StatCard

<div class="card cms-stat-card h-100 border-0 shadow-sm">
    <div class="card-body d-flex align-items-center gap-3">
        <span class="cms-stat-icon text-bg-@Model.Color bg-opacity-10 text-@Model.Color">
            <i class="bi @Model.Icon"></i>
        </span>
        <div>
            <div class="fs-4 fw-semibold lh-1">@Model.Value</div>
            <div class="text-secondary small mt-1">@Model.Title</div>
        </div>
        @if (Model.Url is not null)
        {
            <a href="@Model.Url" class="stretched-link" aria-label="@Model.Title"></a>
        }
    </div>
</div>
